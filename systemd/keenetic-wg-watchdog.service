[Unit]
Description=Keenetic WireGuard peer watchdog
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/keenetic-wg-watchdog --run
RuntimeDirectory=keenetic-wg-watchdog
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
User=root
Group=root
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/keenetic-wg-watchdog
